[exit 0]
$ make -q; code=$?; echo "make -q status = $code"
make -q status = 0
[exit 0]
$ make -n -W src/sum.c
mkdir -p build
gcc  -std=c11 -Wall -Wextra -Wpedantic -Werror -O2 -c src/sum.c -o build/sum.o
gcc  build/sum.o  -o build/sum
